# Only configure on the server. Never commit .env or paste keys into frontend code.
DIFY_API_BASE=https://api.dify.ai/v1
DIFY_RENTAL_API_KEY=
DIFY_EMPLOYMENT_API_KEY=
DIFY_PRIVACY_API_KEY=
HOST=127.0.0.1
PORT=8787
# Required when HOST is not loopback. Use a long, random demo access code.
DEMO_ACCESS_CODE=
# Optional frontend origin when serving the frontend separately; no trailing slash.
ALLOWED_ORIGIN=

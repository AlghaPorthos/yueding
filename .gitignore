# OpenRig 本地运行时与一次性产物
/exhaust/
/.openrig/

# Python 运行产物
backend/.venv/
__pycache__/
*.pyc
.pytest_cache/

# 后端本地数据：忽略运行期数据库，保留法律语料 legal_corpus.jsonl
backend/data/*.sqlite3
backend/data/*.sqlite3-*
backend/data/*.db

# macOS / 编辑器
.DS_Store
__MACOSX/
*.swp
.vscode/
.idea/
*.sublime-*

# 日志与临时文件
*.log
*.tmp
*.bak
tmp/

# Node
node_modules/
npm-debug.log*
yarn-error.log*

# 环境与密钥（key 只放环境变量，不进仓库）
.env
.env.*
*.pem
*.key

# 本地测试产物
coverage/
*.lcov

# 本地 AI 助手配置（各机器私有，不入库）
.claude/
.codex/
.agents/

# PPT Master 脚手架（官方推荐 git clone 安装，约 121MB，含独立 .git/.venv/生成产物 projects/，
# 自身可 git pull 升级，故整体不入库；成品 PPT 如需入库请拷到 docs/ 下）
/ppt-master/

# 演示录屏与截图：体积大、可再生，不入库；PPT 工作目录同样仅本地使用
/videos/
*.mp4
/screenshots/
/screenshots.zip
/ppt-redesign/
